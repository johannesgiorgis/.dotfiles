# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# shell scripts in bin/ use 4-space indent
[*.sh]
indent_size = 4

[bin/*]
indent_size = 4

[*.py]
indent_size = 4

# make requires literal tabs for recipe lines
[Makefile]
indent_style = tab
